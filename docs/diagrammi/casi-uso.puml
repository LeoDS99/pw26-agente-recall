@startuml casi-uso
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 15

actor "Operatore\ncentro prenotazioni" as Op
actor "Responsabile\nliste d'attesa" as Resp

rectangle "Agente per il recall - Gruppo Sanitario Collemare" {
  usecase "UC1 Gestisci il\ngiro di conferme" as UC1
  usecase "UC2 Registra l'esito\ndi un contatto" as UC2
  usecase "UC3 Recupera\nuno slot libero" as UC3
  usecase "UC4 Pianifica il recupero\ndella settimana" as UC4
  usecase "UC5 Verifica\ni tempi d'attesa" as UC5
}
Op -- UC1
Op -- UC2
Op -- UC3
Op -- UC4
Resp -- UC5

' [norank]: PlantUML non usa questa freccia per disporre i casi d'uso, che
' restano così in una colonna, nell'ordine in cui sono dichiarati (da UC1 a UC5).
UC1 .[norank].> UC2 : <<include>>
@enduml
