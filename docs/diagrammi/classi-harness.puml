@startuml classi-harness
skinparam classAttributeIconSize 0
hide empty members
title Harness agentico

class Client <<SDK>>

class Cli {
  - terminale : Interface
  + avvia(agente : Agent) : Promise<void>
  + conferma(chiamata : ChiamataTool) : Promise<boolean>
  + avvisa(testo : string) : void
  + chiudi() : void
}

class Agent {
  - maxIterazioni : number
  - maxScambi : number
  - promptDiSistema : string
  - storia : Messaggio[]
  + esegui(richiesta : string) : Promise<EsitoAgente>
  + azzeraMemoria() : void
  - ricorda(richiesta : string, risposta : string) : void
  - eseguiChiamata(chiamata : ChiamataTool, tools : SpecTool[], scritture : ChiamataTool[]) : Promise<string>
  - concludi(esito : EsitoAgente) : EsitoAgente
}

interface ModelProvider {
  + nome : string
  + chat(messaggi, tools) : Promise<RispostaModello>
}

class OllamaProvider {
  - client : Ollama
  - modello : string
  - contesto : number
}

interface ConfermaUtente {
  + conferma(chiamata : ChiamataTool) : Promise<boolean>
}

class McpToolClient {
  - client : Client
  - server : ComandoServer
  - collegato : boolean
  + connetti() : Promise<void>
  + elencaTool() : Promise<SpecTool[]>
  + chiamaTool(nome, args) : Promise<EsitoTool>
  + chiudi() : Promise<void>
  - verificaCollegamento() : void
}

class JsonlLogger {
  - percorsoFile : string
  + {static} percorsoPredefinito(cartella) : string
  + registra(evento : EventoLog) : void
}

Cli --> Agent
Cli ..|> ConfermaUtente
Agent --> ModelProvider
Agent --> McpToolClient
Agent --> ConfermaUtente
Agent --> JsonlLogger
OllamaProvider ..|> ModelProvider
McpToolClient --> Client
@enduml