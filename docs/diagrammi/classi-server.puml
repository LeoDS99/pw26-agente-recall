@startuml classi-server
skinparam classAttributeIconSize 0
hide empty members
title Server MCP e back-end

class McpServer <<SDK>>

class RecallMcpServer {
  - server : McpServer
  - tools : RecallTool[]
  - registra(tool : RecallTool)
  + avvia()
}

abstract class RecallTool {
  + nome : string
  + descrizione : string
  + schemaInput : ZodSchema
  + schemaOutput : ZodSchema
  + soloLettura : boolean
  # repo : RecallRepository
  + {abstract} esegui(args) : Promise<dati>
}

class AppuntamentiDaConfermare
class RegistraEsitoContatto
class SlotLiberi
class ProponiCandidati
class RiassegnaSlot
class VerificaTempiAttesa

package "Back-end" {
  class RecallRepository {
    - pool : Pool
    + appuntamentiDaConfermare(giorni, sedeId?)
    + registraEsito(prenotazioneId, esito)
    + slotLiberi(dal, al, prestazioneId?, sedeId?)
    + candidatiPerSlot(slotId, limite)
    + riassegnaSlot(slotId, richiestaId)
    + tempiAttesa(dal, al, prestazioneId?, classe?)
  }

  class SoglieAttesa <<config>> {
    + {static} giorni(classe, tipoPrestazione) : number
  }

  class ErroreDominio
}

RecallMcpServer --> McpServer
RecallMcpServer o-- "6" RecallTool
RecallTool <|-- AppuntamentiDaConfermare
RecallTool <|-- RegistraEsitoContatto
RecallTool <|-- SlotLiberi
RecallTool <|-- ProponiCandidati
RecallTool <|-- RiassegnaSlot
RecallTool <|-- VerificaTempiAttesa
RecallTool --> RecallRepository
RecallRepository ..> SoglieAttesa
RecallRepository ..> ErroreDominio : lancia
RecallMcpServer ..> ErroreDominio : gestisce
@enduml
